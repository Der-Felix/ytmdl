# Copy this file to .env before using compose.yaml. It contains example values
# only — replace every password before running anything that matters.
#
# The deployment is named ytmdl (containers ytmdl-backend and ytmdl-db on the
# network ytmdl-net). The backend's own settings keep the MUSICDL_* prefix for
# backwards compatibility; legacy YTDM_* variables remain accepted.

# Build/Compose settings (not read by the backend).
# Registry / Image Version
YTMDL_VERSION=0.19.0

YTMDL_HOST_PORT=8080
YTMDL_DATA_PATH=./data
YTMDL_MUSIC_PATH=./music

# PostgreSQL container (ytmdl-db). POSTGRES_PASSWORD is required and must match
# the password in MUSICDL_DATABASE_URL below.
POSTGRES_DB=ytmdl
POSTGRES_USER=ytmdl
POSTGRES_PASSWORD=change-me

# Backend listener, library path, and reverse proxy settings.
MUSICDL_LISTEN_ADDR=0.0.0.0:8080
MUSICDL_LIBRARY=/music
# Comma-separated list of trusted proxy CIDRs/IPs. Defaults to loopback only (127.0.0.1/32, ::1/128).
# In standard compose deployments, ytmdl-net (172.31.250.0/28) is passed automatically.
# MUSICDL_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.31.250.0/28
# MUSICDL_COOKIE_SECURE=false

# PostgreSQL connection. "db" is the compose service name and is resolved over
# ytmdl-net; never put a container IP address here. The database is not
# published on the host.
MUSICDL_DATABASE_URL=postgres://ytmdl:change-me@db:5432/ytmdl?sslmode=disable

# Connection pool. The defaults suit a single backend with a handful of
# workers; raise MUSICDL_DB_MAX_CONNS only together with the worker count.
# MUSICDL_DB_MAX_CONNS=10
# MUSICDL_DB_MIN_CONNS=2
# MUSICDL_DB_MAX_CONN_LIFETIME=30m
# MUSICDL_DB_MAX_CONN_IDLE_TIME=5m
# MUSICDL_DB_CONNECT_TIMEOUT=10s
# How long the backend waits for PostgreSQL while starting before it gives up.
# MUSICDL_DB_STARTUP_TIMEOUT=90s
# MUSICDL_DB_STARTUP_BACKOFF=1s

# Worker and runtime tools.
MUSICDL_CONCURRENT_DOWNLOADS=2
MUSICDL_YTDLP=/usr/bin/yt-dlp
MUSICDL_FFMPEG=/usr/bin/ffmpeg
MUSICDL_FFPROBE=/usr/bin/ffprobe

# Optional Spotify metadata support. Leave commented to use YouTube Music as
# the available metadata provider.
# YTDM_SPOTIFY_CLIENT_ID=
# YTDM_SPOTIFY_CLIENT_SECRET=

# Deezer request pacing. Deezer allows about 10 requests per second per address
# and answers the excess with a quota error instead of data, which costs a large
# artist most of its catalogue. The defaults stay below that ceiling and are
# shared by every consumer of the provider.
# MUSICDL_DEEZER_REQUESTS_PER_SECOND=8
# MUSICDL_DEEZER_BURST=5
# MUSICDL_DEEZER_MAX_RETRIES=3
# MUSICDL_DEEZER_RETRY_BACKOFF=500ms
# MUSICDL_DEEZER_MAX_RETRY_BACKOFF=8s

# Artist subscriptions. The defaults are fine for a normal deployment; set
# MUSICDL_SUBSCRIPTIONS_ENABLED=false to keep the endpoints and the manual
# "check now" but stop the periodic sync. The check interval is how finely the
# sync interval is observed, not how often a provider is contacted.
# MUSICDL_SUBSCRIPTIONS_ENABLED=true
# MUSICDL_SUBSCRIPTION_SYNC_INTERVAL=24h
# MUSICDL_SUBSCRIPTION_CHECK_INTERVAL=15m
# MUSICDL_SUBSCRIPTION_RETRY_INTERVAL=1h
# MUSICDL_SUBSCRIPTION_SYNC_TIMEOUT=30m
# MUSICDL_SUBSCRIPTION_BATCH_SIZE=25

# Optional operational settings supported by the current backend.
# YTDM_SERVER_SHUTDOWN_TIMEOUT=30s
# YTDM_TOOL_TIMEOUT=5m
# YTDM_COOKIEFILE=/data/cookies.txt
# YTDM_LOG_LEVEL=info
# YTDM_LOG_FORMAT=json

# Optional Genius lyrics fallback provider.
# Disabled by default. Can be toggled dynamically in Settings (Web UI).
# MUSICDL_PROVIDERS_GENIUS_ENABLED=false
#
# Optional Genius Client Access Token (from https://genius.com/api-clients).
# If provided, searches use the authenticated official Genius Search API.
# If omitted, a best-effort public search endpoint is used as a fallback.
# MUSICDL_PROVIDERS_GENIUS_ACCESS_TOKEN=

# Optional GitHub release update detection (v0.15+).
# Automatically checks for new stable releases on GitHub and displays them in Settings.
# Set MUSICDL_UPDATE_CHECKS_ENABLED=false to completely disable all outbound requests.
# MUSICDL_UPDATE_CHECKS_ENABLED=true
# MUSICDL_UPDATE_REPOSITORY=Der-Felix/ytmdl
# MUSICDL_UPDATE_CHECK_INTERVAL=1h
