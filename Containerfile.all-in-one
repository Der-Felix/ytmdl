# syntax=docker/dockerfile:1
#
# Single image: the Go backend serving the web application itself
# (MUSICDL_WEB_DIR), published as ghcr.io/der-felix/ytmdl. One process, no
# nginx, no supervisor; PostgreSQL stays a separate container.
#
# The build context is the repository root. Containerfile.all-in-one.dockerignore
# replaces .dockerignore for this file, because the root .dockerignore leaves
# the frontend out of the backend image's context.
#
#   docker build -f Containerfile.all-in-one -t ytmdl:local .
#
# The stages repeat Containerfile and frontend/Containerfile with the same
# pinned base images; change them together.

# Stage 1: the web application, as in frontend/Containerfile.
FROM --platform=$BUILDPLATFORM docker.io/oven/bun:1.3-alpine@sha256:5acc90a93e91ff07bf72aa90a7c9f0fa189765aec90b47bdbf2152d2196383c0 AS web

ARG BUILDKIT_SBOM_SCAN_STAGE=true

WORKDIR /app

COPY frontend/package.json frontend/bun.lock ./
RUN bun install --frozen-lockfile

COPY frontend/index.html frontend/vite.config.ts frontend/tsconfig.json frontend/tsconfig.app.json frontend/tsconfig.node.json ./
COPY frontend/src/ ./src/
COPY frontend/public/ ./public/

RUN bun run build

# Precompress the text files nginx would compress on the fly (gzip_types,
# gzip_min_length 1024). The backend sends name.gz to clients that accept
# gzip; a sibling that does not save anything is dropped. Reading from stdin
# keeps file names and timestamps out of the gzip header.
RUN find dist -type f \( -name '*.html' -o -name '*.js' -o -name '*.mjs' -o -name '*.css' \
      -o -name '*.json' -o -name '*.map' -o -name '*.svg' -o -name '*.txt' -o -name '*.xml' \) \
      -size +1023c | while read -r file; do \
        gzip -9 -c < "$file" > "$file.gz"; \
        if [ "$(wc -c < "$file.gz")" -ge "$(wc -c < "$file")" ]; then rm "$file.gz"; fi; \
      done

# Stage 2: the backend binary, as in Containerfile.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS builder

WORKDIR /src/backend

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./
COPY .release-version /src/.release-version

ARG TARGETOS TARGETARCH
ARG VERSION=""
RUN build_version="${VERSION:-$(cat /src/.release-version)}" && \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build \
      -trimpath \
      -ldflags="-s -w -X main.version=${build_version}" \
      -o /out/musicdl \
      ./cmd/server

# Stage 3: the runtime of the backend image plus the built web application.
FROM docker.io/library/alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS runtime

RUN apk upgrade --no-cache && \
    apk add --no-cache \
      ca-certificates \
      ffmpeg \
      chromaprint \
      yt-dlp && \
    addgroup -S -g 10001 musicdl && \
    adduser -S -D -H -u 10001 -G musicdl musicdl && \
    install -d -o root -g root -m 0755 /app && \
    install -d -o musicdl -g musicdl -m 0755 /data /music /tmp/musicdl

COPY --from=builder /out/musicdl /app/musicdl
# Owned by root (COPY's default) and only readable for the service user, like
# the binary.
COPY --from=web /app/dist /app/web

# MUSICDL_DATABASE_URL has no default on purpose: the backend must be pointed
# at a PostgreSQL server explicitly and refuses to start without one.
ENV MUSICDL_LISTEN_ADDR=0.0.0.0:8080 \
    MUSICDL_WEB_DIR=/app/web \
    MUSICDL_LIBRARY=/music \
    MUSICDL_COOKIE_DIR=/data/cookies \
    MUSICDL_CONCURRENT_DOWNLOADS=2 \
    MUSICDL_YTDLP=/usr/bin/yt-dlp \
    MUSICDL_FFMPEG=/usr/bin/ffmpeg \
    MUSICDL_FFPROBE=/usr/bin/ffprobe \
    HOME=/tmp/musicdl \
    XDG_CACHE_HOME=/tmp/musicdl/.cache \
    DENO_DIR=/tmp/musicdl/deno

WORKDIR /app
VOLUME ["/data", "/music"]
EXPOSE 8080
STOPSIGNAL SIGTERM

USER musicdl:musicdl

# The API with its database check, and the application shell.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -q -O /dev/null 'http://127.0.0.1:8080/api/v1/health?scope=essential' && \
      wget -q -O /dev/null 'http://127.0.0.1:8080/' || exit 1

ENTRYPOINT ["/app/musicdl"]
